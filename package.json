{
  "name": "eyerest",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Amirnlz/eyerest",
  "description": "Cross-platform desktop reminder: 20-20-20 eye rests with overlay, skip and postpone.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "dev:fast": "EYEREST_FAST=1 electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:renderer": "vite harness",
    "e2e": "npm run build && playwright test",
    "e2e:gallery": "playwright test -c playwright.gallery.config.ts",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
