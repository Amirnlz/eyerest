{
  "appId": "io.github.amirnlz.eyerest",
  "productName": "eyerest",
  "executableName": "eyerest",
  "copyright": "Copyright (c) eyerest contributors",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**",
    "package.json"
  ],
  "asar": true,
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "Amir Nasrollahzadeh <amiirnlz79@gmail.com>",
    "synopsis": "Reminds you to rest your eyes"
  },
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.utilities",
    "identity": null,
    "extendInfo": {
      "LSUIElement": true
    }
  }
}
